HTTP_ADDR=:8080
# Published loopback port in Compose; the container still listens on 8080.
MCP_HOST_PORT=18080
POSTGRES_PASSWORD=replace-with-random-database-password
# On the host use localhost plus a manually published DB port; in Compose use postgres:5432.
DATABASE_URL=postgres://mailmcp:replace-with-random-database-password@postgres:5432/mailmcp?sslmode=disable
# openssl rand -base64 32; keep this key stable and back it up separately.
MCP_SECRET_KEY=
# openssl rand -hex 32; also protects /metrics in OIDC mode.
MCP_AUTH_TOKEN=
LOG_LEVEL=info
AUTH_MODE=bearer
# For ChatGPT: set AUTH_MODE=oauth and configure the built-in owner login below.
# oidc remains available for an external authorization server.
OIDC_ISSUER=
MCP_PUBLIC_URL=
OIDC_ALLOWED_SUBJECT=
# Built-in OAuth: two distinct secrets, each generated with openssl rand -hex 32.
# Client secret goes in ChatGPT's OAuth settings; login token only on our consent page.
MCP_OAUTH_CLIENT_ID=mail-mcp-chatgpt
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_LOGIN_TOKEN=
# Copy the exact callback from the connection UI; comma-separated, no wildcards.
MCP_OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
# Optional HTTPS Compose profile with automatic ACME certificates.
MCP_DOMAIN=
# Only for deploy/compose.shared-proxy.yml: existing reverse proxy Docker network.
MCP_PROXY_NETWORK=
