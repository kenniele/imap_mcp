HTTP_ADDR=:8080
POSTGRES_PASSWORD=replace-with-random-database-password
# On the host use localhost plus a manually published DB port; in Compose use postgres:5432.
DATABASE_URL=postgres://mailmcp:replace-with-random-database-password@postgres:5432/mailmcp?sslmode=disable
# openssl rand -base64 32; keep this key stable and back it up separately.
MCP_SECRET_KEY=
# openssl rand -hex 32; also protects /metrics in OIDC mode.
MCP_AUTH_TOKEN=
LOG_LEVEL=info
AUTH_MODE=bearer
# For ChatGPT: configure an external OAuth 2.1 / OIDC issuer, then switch to oidc.
OIDC_ISSUER=
MCP_PUBLIC_URL=
OIDC_ALLOWED_SUBJECT=
# Optional HTTPS Compose profile with automatic ACME certificates.
MCP_DOMAIN=
